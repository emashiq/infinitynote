{
  "name": "infinity-notes",
  "productName": "Infinity Notes",
  "version": "0.2.0",
  "private": true,
  "description": "Offline notes, stickies and reminders for Windows and Linux.",
  "desktopName": "infinity-notes.desktop",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Ashiqur Rahman Emran",
  "homepage": "https://emashiq.github.io/infinitynote/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emashiq/infinitynote.git"
  },
  "bugs": "https://github.com/emashiq/infinitynote/issues",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "node tools/run-e2e.mjs",
    "test:e2e:packaged": "node tools/run-e2e.mjs --packaged",
    "check": "npm run lint && npm run typecheck && npm run test:unit && npm run test:integration && npm run check:traceability",
    "check:traceability": "node tools/check-traceability.mjs --repo .",
    "verify:native": "node tools/verify-native.mjs",
    "setup:electron": "node node_modules/electron/install.js",
    "package:current": "node tools/package.mjs current",
    "package:win": "node tools/package.mjs win",
    "package:linux": "node tools/package.mjs linux",
    "verify:install:win": "node tools/verify-windows-install.mjs",
    "notices": "node tools/third-party-notices.mjs"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "luxon": "3.7.2",
    "yauzl": "3.4.0",
    "yazl": "3.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electron/fuses": "1.8.0",
    "@eslint/js": "10.0.1",
    "@fortune-sheet/core": "1.0.4",
    "@fortune-sheet/react": "1.0.4",
    "@playwright/test": "1.64.0",
    "@portone/docx-editor": "0.6.7",
    "@pptx-glimpse/document": "0.16.0",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-code-block": "3.31.4",
    "@tiptap/extension-code-block-lowlight": "3.31.4",
    "@tiptap/extension-list": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/extension-text-style": "3.31.4",
    "@tiptap/extension-unique-id": "3.31.4",
    "@tiptap/extensions": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@types/better-sqlite3": "9.6.0",
    "@types/d3-force": "3.0.10",
    "@types/d3-quadtree": "3.0.6",
    "@types/jsdom": "30.0.0",
    "@types/luxon": "3.7.6",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "@vitejs/plugin-react": "5.2.0",
    "chrono-node": "2.10.2",
    "d3-force": "3.0.0",
    "d3-quadtree": "3.0.1",
    "docx-preview": "0.4.1",
    "dompurify": "3.4.16",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "exceljs": "4.4.0",
    "fflate": "0.8.3",
    "globals": "17.13.0",
    "highlight.js": "11.12.0",
    "jsdom": "30.1.2",
    "katex": "0.19.0",
    "lowlight": "3.3.0",
    "lucide-react": "1.53.0",
    "mermaid": "11.17.2",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "pptx-glimpse": "5.3.1",
    "prosemirror-collab": "1.3.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "7.3.7",
    "vitest": "5.0.3"
  },
  "overrides": {
    "exceljs": {
      "unzipper": "0.12.5",
      "uuid": "11.1.1"
    },
    "@fortune-sheet/core": {
      "uuid": "11.1.1"
    },
    "mermaid": {
      "katex": "$katex"
    }
  }
}
